# Vite browser configuration. Firebase web config is public; backend credentials never belong here.
VITE_API_BASE_URL=http://localhost:8080
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Backend environment (configure on the Java host, not in this file or the frontend build).
PORT=8080
FIREBASE_ENABLED=true
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/firebase-service-account.json
DRIVE_ENABLED=true
DRIVE_LOGO_FOLDER_ID=
CORS_ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8080
